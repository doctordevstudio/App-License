# ---------- required ----------
SECRET_KEY=change-me-to-a-long-random-string
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# paste the whole service-account JSON on ONE line (Render: Environment -> add variable)
FIREBASE_CREDENTIALS_JSON=
BOT_TOKEN=123456:ABC-your-bot-token

# first admin (only used when the database has no admin yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword1

# ---------- optional ----------
# Render sets RENDER_EXTERNAL_URL automatically. Set BASE_URL for custom domains.
BASE_URL=
ADMIN_CHAT_ID=
TIMEZONE=Asia/Kolkata
MAX_TXN_PER_DAY=5
TXN_TTL_SECONDS=600
# local development only
APP_ENV=production
USE_MEMORY_DB=0
